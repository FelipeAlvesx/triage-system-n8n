# N8N Configuration Example
# Copy this file to .env and fill with your actual values

# GROQ Configuration (FREE AI Provider)
# Get your API key at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# N8N Webhook Configuration (after importing workflow)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/medical-triage

# Optional: Model Configuration
# Available models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1000

# Optional: Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
